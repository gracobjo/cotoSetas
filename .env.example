# =============================================================================
# Villardeciervos Micología — plantilla de entorno
# Copia este fichero a `.env` o `.env.local` y rellena los valores.
# =============================================================================

PERMIT_HMAC_SECRET=cambia-este-secreto-largo-y-aleatorio-en-produccion

# CRÍTICO para escanear el QR desde el móvil (usa IP LAN, no localhost)
# Ejemplo: http://192.168.1.50:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Permisos Villardeciervos <onboarding@resend.dev>

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Admin (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-password-segura
ADMIN_SESSION_SECRET=cambia-secreto-sesion-admin

# --- Neon Postgres (producción / Vercel) ---
# Connection string pooled desde Neon Console → Connect
DATABASE_URL=

# FORCE_PARTE_DETECTADO=true
# MICOCYL_NEWS_URL=https://www.micocyl.es/
